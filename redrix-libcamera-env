#!/usr/bin/env bash
# Source this file before using the Redrix-local libcamera install.

REDRIX_LIBCAMERA_PREFIX="${REDRIX_LIBCAMERA_PREFIX:-/opt/redrix-libcamera}"
REDRIX_LIBCAMERA_LIBDIR="${REDRIX_LIBCAMERA_LIBDIR:-$REDRIX_LIBCAMERA_PREFIX/lib/x86_64-linux-gnu}"

export PATH="$REDRIX_LIBCAMERA_PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$REDRIX_LIBCAMERA_LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GST_PLUGIN_PATH="$REDRIX_LIBCAMERA_LIBDIR/gstreamer-1.0${GST_PLUGIN_PATH:+:$GST_PLUGIN_PATH}"
export LIBCAMERA_DATA_DIR="$REDRIX_LIBCAMERA_PREFIX/share/libcamera"
export LIBCAMERA_IPA_MODULE_PATH="$REDRIX_LIBCAMERA_LIBDIR/libcamera/ipa"
export LIBCAMERA_IPA_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/redrix-libcamera/ipa:$REDRIX_LIBCAMERA_PREFIX/share/libcamera/ipa"
export LIBCAMERA_IPA_PROXY_PATH="$REDRIX_LIBCAMERA_PREFIX/libexec/libcamera"
