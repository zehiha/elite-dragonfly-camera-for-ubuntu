+static int read_copy_read(struct impl *this)
+{
+	struct port *port = &this->out_ports[0];
+	struct spa_v4l2_device *dev = &port->dev;
+	struct buffer *b = NULL;
+	struct spa_data *d;
+	ssize_t size;
+	uint32_t i;
+
+	for (i = 0; i < port->n_buffers; i++) {
+		struct buffer *candidate = &port->buffers[i];
+		if (!SPA_FLAG_IS_SET(candidate->flags, BUFFER_FLAG_OUTSTANDING) &&
+		    !SPA_FLAG_IS_SET(candidate->flags, BUFFER_FLAG_READY)) {
+			b = candidate;
+			break;
+		}
+	}
+	if (b == NULL)
+		return 0;
+
+	d = b->outbuf->datas;
+	size = read(dev->fd, b->client_ptr, SPA_MIN((uint32_t)b->client_size, d[0].maxsize));
+	if (size < 0) {
+		if (errno == EAGAIN || errno == EWOULDBLOCK)
+			return -EAGAIN;
+		spa_log_warn(this->log, "'%s' read-copy read: %m", this->props.device);
+		return -errno;
+	}
+	if (size == 0)
+		return -EAGAIN;
+
+	if (b->h) {
+		b->h->flags = 0;
+		b->h->offset = 0;
+		b->h->seq++;
+		b->h->pts = 0;
+		b->h->dts_offset = 0;
+	}
+
+	d[0].chunk->offset = 0;
+	d[0].chunk->size = size;
+	d[0].chunk->stride = port->fmt.fmt.pix.bytesperline;
+	d[0].chunk->flags = 0;
+
+	SPA_FLAG_SET(b->flags, BUFFER_FLAG_READY);
+	spa_list_append(&port->queue, &b->link);
+	return 0;
+}
+
+static void read_copy_set_timer(struct impl *this, bool enabled)
+{
+	struct port *port = &this->out_ports[0];
+	struct itimerspec ts = { 0 };
+
+	if (this->data_system == NULL || port->source.fd < 0)
+		return;
+
+	if (enabled) {
+		ts.it_value.tv_nsec = 1;
+		ts.it_interval.tv_nsec = 33333333;
+	}
+	spa_system_timerfd_settime(this->data_system, port->source.fd, 0, &ts, NULL);
+}
+
+static void read_copy_on_timer(struct spa_source *source)
+{
+	struct impl *this = source->data;
+	struct port *port = &this->out_ports[0];
+	struct spa_io_buffers *io;
+	struct buffer *b;
+	uint64_t expirations;
+	int res;
+
+	res = spa_system_timerfd_read(this->data_system, source->fd, &expirations);
+	if (res < 0 && res != -EAGAIN) {
+		spa_log_warn(this->log, "'%s' read-copy timerfd: %s",
+				this->props.device, spa_strerror(res));
+		return;
+	}
+
+	res = read_copy_read(this);
+	if (res < 0 && res != -EAGAIN)
+		return;
+	if (spa_list_is_empty(&port->queue))
+		return;
+
+	io = port->io;
+	if (io == NULL) {
+		b = spa_list_first(&port->queue, struct buffer, link);
+		spa_list_remove(&b->link);
+		SPA_FLAG_CLEAR(b->flags, BUFFER_FLAG_READY);
+		SPA_FLAG_SET(b->flags, BUFFER_FLAG_OUTSTANDING);
+		spa_v4l2_buffer_recycle(this, b->id);
+	} else if (io->status != SPA_STATUS_HAVE_DATA) {
+		if (io->buffer_id < port->n_buffers)
+			spa_v4l2_buffer_recycle(this, io->buffer_id);
+
+		b = spa_list_first(&port->queue, struct buffer, link);
+		spa_list_remove(&b->link);
+		SPA_FLAG_CLEAR(b->flags, BUFFER_FLAG_READY);
+		SPA_FLAG_SET(b->flags, BUFFER_FLAG_OUTSTANDING);
+
+		io->buffer_id = b->id;
+		io->status = SPA_STATUS_HAVE_DATA;
+	}
+	spa_node_call_ready(&this->callbacks, SPA_STATUS_HAVE_DATA);
+}
+
+static int read_copy_init(struct impl *this, struct spa_buffer **buffers, uint32_t n_buffers)
+{
+	struct port *port = &this->out_ports[0];
+	unsigned int i;
+
+	spa_log_debug(this->log, "'%s' read-copy init with %u buffers",
+			this->props.device, n_buffers);
+
+	for (i = 0; i < n_buffers; i++) {
+		struct buffer *b;
+		struct spa_data *d;
+
+		if (buffers[i]->n_datas < 1) {
+			spa_log_error(this->log, "invalid buffer data");
+			return -EINVAL;
+		}
+
+		b = &port->buffers[i];
+		d = buffers[i]->datas;
+
+		b->id = i;
+		b->outbuf = buffers[i];
+		b->flags = BUFFER_FLAG_READ_COPY;
+		b->h = spa_buffer_find_meta_data(buffers[i], SPA_META_Header, sizeof(*b->h));
+		b->client_ptr = NULL;
+		b->client_size = d[0].maxsize;
+
+		if (d[0].type == SPA_DATA_MemPtr && d[0].data != NULL) {
+			b->client_ptr = d[0].data;
+		} else if ((d[0].type == SPA_DATA_MemFd || d[0].type == SPA_DATA_DmaBuf) && d[0].fd >= 0) {
+			b->client_ptr = mmap(NULL,
+					d[0].maxsize,
+					PROT_READ | PROT_WRITE, MAP_SHARED,
+					d[0].fd,
+					d[0].mapoffset);
+			if (b->client_ptr == MAP_FAILED) {
+				spa_log_error(this->log, "'%s' client mmap: %m", this->props.device);
+				b->client_ptr = NULL;
+				return -errno;
+			}
+			SPA_FLAG_SET(b->flags, BUFFER_FLAG_CLIENT_MAPPED);
+		} else {
+			spa_log_error(this->log, "'%s' unsupported read-copy buffer type:%08x",
+					this->props.device, d[0].type);
+			return -ENOTSUP;
+		}
+
+		d[0].chunk->offset = 0;
+		d[0].chunk->size = 0;
+		d[0].chunk->stride = port->fmt.fmt.pix.bytesperline;
+		d[0].chunk->flags = 0;
+	}
+
+	port->n_buffers = n_buffers;
+	return 0;
+}
+
+static int __attribute__((unused)) mmap_copy_init(struct impl *this, struct spa_buffer **buffers, uint32_t n_buffers)
+{
+	struct port *port = &this->out_ports[0];
+	struct spa_v4l2_device *dev = &port->dev;
+	struct v4l2_requestbuffers reqbuf;
+	unsigned int i;
+
+	port->memtype = V4L2_MEMORY_MMAP;
+	spa_log_debug(this->log, "'%s' mmap-copy init with %u buffers",
+			this->props.device, n_buffers);
+
+	spa_zero(reqbuf);
+	reqbuf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	reqbuf.memory = port->memtype;
+	reqbuf.count = n_buffers;
+
+	if (xioctl(dev->fd, VIDIOC_REQBUFS, &reqbuf) < 0) {
+		spa_log_error(this->log, "'%s' VIDIOC_REQBUFS: %m", this->props.device);
+		return -errno;
+	}
+	if (reqbuf.count < n_buffers) {
+		spa_log_error(this->log, "'%s' can't allocate enough copy buffers (%d < %d)",
+				this->props.device, reqbuf.count, n_buffers);
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < n_buffers; i++) {
+		struct buffer *b;
+		struct spa_data *d;
+		bool already_queued;
+
+		if (buffers[i]->n_datas < 1) {
+			spa_log_error(this->log, "invalid buffer data");
+			return -EINVAL;
+		}
+
+		b = &port->buffers[i];
+		d = buffers[i]->datas;
+		spa_log_debug(this->log, "'%s' copy buffer %u type:%08x fd:%ld max:%u",
+				this->props.device, i, d[0].type, (long)d[0].fd, d[0].maxsize);
+
+		b->id = i;
+		b->outbuf = buffers[i];
+		b->flags = BUFFER_FLAG_OUTSTANDING | BUFFER_FLAG_COPY;
+		b->h = spa_buffer_find_meta_data(buffers[i], SPA_META_Header, sizeof(*b->h));
+		b->client_ptr = NULL;
+		b->client_size = d[0].maxsize;
+
+		if (d[0].type == SPA_DATA_MemPtr && d[0].data != NULL) {
+			b->client_ptr = d[0].data;
+		} else if ((d[0].type == SPA_DATA_MemFd || d[0].type == SPA_DATA_DmaBuf) && d[0].fd >= 0) {
+			b->client_ptr = mmap(NULL,
+					d[0].maxsize,
+					PROT_READ | PROT_WRITE, MAP_SHARED,
+					d[0].fd,
+					d[0].mapoffset);
+			if (b->client_ptr == MAP_FAILED) {
+				spa_log_error(this->log, "'%s' client mmap: %m", this->props.device);
+				b->client_ptr = NULL;
+				return -errno;
+			}
+			SPA_FLAG_SET(b->flags, BUFFER_FLAG_CLIENT_MAPPED);
+		} else {
+			spa_log_error(this->log, "'%s' unsupported copy buffer type:%08x",
+					this->props.device, d[0].type);
+			return -ENOTSUP;
+		}
+
+		spa_zero(b->v4l2_buffer);
+		b->v4l2_buffer.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+		b->v4l2_buffer.memory = port->memtype;
+		b->v4l2_buffer.index = i;
+
+		if (xioctl(dev->fd, VIDIOC_QUERYBUF, &b->v4l2_buffer) < 0) {
+			spa_log_error(this->log, "'%s' VIDIOC_QUERYBUF: %m", this->props.device);
+			return -errno;
+		}
+
+		already_queued = b->v4l2_buffer.flags & V4L2_BUF_FLAG_QUEUED;
+
+		b->ptr = mmap(NULL,
+				b->v4l2_buffer.length,
+				PROT_READ, MAP_SHARED,
+				dev->fd,
+				b->v4l2_buffer.m.offset);
+		if (b->ptr == MAP_FAILED) {
+			spa_log_error(this->log, "'%s' mmap: %m", this->props.device);
+			b->ptr = NULL;
+			return -errno;
+		}
+		SPA_FLAG_SET(b->flags, BUFFER_FLAG_MAPPED);
+
+		d[0].chunk->offset = 0;
+		d[0].chunk->size = 0;
+		d[0].chunk->stride = port->fmt.fmt.pix.bytesperline;
+		d[0].chunk->flags = 0;
+
+		if (already_queued) {
+			spa_log_debug(this->log, "'%s' copy buffer %u already queued",
+					this->props.device, i);
+			SPA_FLAG_CLEAR(b->flags, BUFFER_FLAG_OUTSTANDING);
+		} else {
+			int qres = spa_v4l2_buffer_recycle(this, i);
+			spa_log_debug(this->log, "'%s' copy buffer %u qbuf result %d",
+					this->props.device, i, qres);
+		}
+	}
+
+	port->n_buffers = n_buffers;
+	spa_log_debug(this->log, "%s: have %u v4l2loopback mmap-copy buffers", dev->path, n_buffers);
+
+	return 0;
+}
